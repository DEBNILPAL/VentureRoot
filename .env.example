# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Data Source Mode
# 'json'     -> Uses frontend JSON seed/reference data (development/mock mode)
# 'database' -> Uses the backend API/database-backed data (production/integrated mode)
NEXT_PUBLIC_DATA_SOURCE=json

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API Key for AI Business Advisor
GEMINI_API_KEY=
